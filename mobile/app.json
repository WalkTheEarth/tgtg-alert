{
  "expo": {
    "name": "TGTG Alert",
    "slug": "tgtg-alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tgtgalert",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F1115",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tgtgalert.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan the pairing QR code from your own server.",
        "NSLocationWhenInUseUsageDescription": "Used to search for Too Good To Go bags near you and to set where a watch should look.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tgtgalert.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#00C48C",
          "defaultChannel": "tgtg-alerts-v1"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan the pairing QR code from your own server."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to search for Too Good To Go bags near you."
        }
      ],
      "expo-secure-store"
    ]
  }
}
